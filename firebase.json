{
  "hosting": {
    "site": "stat-fll",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "HANDOFF.md",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      }
    ]
  }
}
